{
  "id": "rss_reader",
  "name": "RSS Reader",
  "version": "1.0.0",
  "description": "Display the newest headlines from any RSS 2.0 or Atom feed",
  "author": "FiestaBoard Team",
  "repository": "https://github.com/Fiestaboard/fiestaboard-plugin--rss-reader",
  "documentation": "README.md",
  "icon": "rss",
  "category": "data",
  "min_refresh_seconds": 300,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enable RSS Reader",
        "default": false
      },
      "feed_url": {
        "type": "string",
        "title": "Feed URL",
        "description": "URL of an RSS 2.0 or Atom feed (e.g. https://hnrss.org/frontpage)",
        "ui:widget": "url"
      },
      "max_items": {
        "type": "integer",
        "title": "Max Items",
        "description": "How many of the newest items to expose (1-10)",
        "default": 5,
        "minimum": 1,
        "maximum": 10
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to re-fetch the feed",
        "default": 900,
        "minimum": 300,
        "maximum": 86400
      }
    },
    "required": [
      "feed_url"
    ]
  },
  "env_vars": [
    {
      "name": "RSS_READER_ENABLED",
      "required": false,
      "description": "Enable RSS reader feature",
      "default": "false"
    }
  ],
  "variables": {
    "groups": {
      "feed": {
        "label": "Feed"
      },
      "newest": {
        "label": "Newest Item"
      }
    },
    "simple": {
      "feed_title": {
        "description": "Title of the feed",
        "type": "string",
        "max_length": 22,
        "group": "feed",
        "example": "Hacker News: Front Page"
      },
      "item_count": {
        "description": "Number of items exposed (up to Max Items)",
        "type": "number",
        "max_length": 2,
        "group": "feed",
        "example": "5"
      },
      "title": {
        "description": "Title of the newest item",
        "type": "string",
        "max_length": 66,
        "group": "newest",
        "example": "Show HN: Is It Greg?"
      },
      "age": {
        "description": "How long ago the newest item was published (5M, 2H, 3D)",
        "type": "string",
        "max_length": 4,
        "group": "newest",
        "example": "12M"
      },
      "link": {
        "description": "URL of the newest item",
        "type": "string",
        "max_length": 200,
        "group": "newest",
        "example": "https://news.ycombinator.com/item?id=49691343"
      }
    },
    "arrays": {
      "items": {
        "label_field": "title",
        "item_fields": [
          "title",
          "age",
          "link"
        ]
      }
    }
  },
  "max_lengths": {
    "items.*.title": 66,
    "items.*.age": 4,
    "items.*.link": 200
  },
  "fiestaboard_version": ">=2.10.0",
  "teaser": "{64}HACKER NEWS",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "{64} HACKER NEWS",
        "SHOW HN: IS IT GREG 5M",
        "NIKE EXITS S&P 100 12M",
        "RUST 2.0 RELEASED   1H",
        "SPACEX LANDS ON MAR 2H",
        "PYTHON 4 ANNOUNCED  3H"
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "{64} HACKER NEWS",
        "IS IT GREG   5M",
        "RUST 2.0     1H"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "RSS Reader Demo",
      "template": [
        "{{rss_reader.feed_title}}",
        "{{rss_reader.items.0.title}}",
        "{{rss_reader.items.1.title}}",
        "{{rss_reader.items.2.title}}",
        "{{rss_reader.items.3.title}}",
        "{{rss_reader.items.4.title}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "RSS Reader (Note)",
      "template": [
        "{{rss_reader.feed_title}}",
        "{{rss_reader.items.0.title}}",
        "{{rss_reader.items.1.title}}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
